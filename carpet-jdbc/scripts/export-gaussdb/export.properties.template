# =============================================================================
# Database Export Configuration Template
# =============================================================================
# Copy this file to export.properties and customize for your environment.
# Usage: ./export.sh --properties export.properties --tables tables.txt
# =============================================================================

# -----------------------------------------------------------------------------
# JDBC Connection Settings (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL example:
jdbc.url=jdbc:postgresql://localhost:5432/mydb
jdbc.user=myuser
jdbc.password=mypassword

# MySQL example:
# jdbc.url=jdbc:mysql://localhost:3306/mydb
# jdbc.user=myuser
# jdbc.password=mypassword

# GaussDB example:
# jdbc.url=jdbc:gaussdb://127.0.0.1:8889/mydb?currentSchema=myschema
# jdbc.user=myuser
# jdbc.password=mypassword

# SQLite example:
# jdbc.url=jdbc:sqlite:/path/to/database.db
# jdbc.user=
# jdbc.password=

# DuckDB example (file-based):
# jdbc.url=jdbc:duckdb:/path/to/database.duckdb
# jdbc.user=
# jdbc.password=

# -----------------------------------------------------------------------------
# Output Settings (REQUIRED)
# -----------------------------------------------------------------------------
# Base directory for Parquet output files.
# Files will be created in: {output.baseDir}/{yyyyMMdd}/{tablename}.parquet
output.baseDir=/data/exports

# -----------------------------------------------------------------------------
# Export Configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# SQL query pattern. Use %s as placeholder for table name.
# Default: SELECT * FROM %s
export.queryPattern=SELECT * FROM %s

# Number of records per batch write to Parquet.
# Higher values = better performance but more memory usage.
# Default: 10000
export.batchSize=10000

# JDBC fetch size for ResultSet processing.
# Default: 1000
export.fetchSize=1000

# Parquet compression codec.
# Options: UNCOMPRESSED, SNAPPY, GZIP, LZO, BROTLI, LZ4, ZSTD
# Default: SNAPPY
export.compression=SNAPPY

# Column naming strategy.
# Options: FIELD_NAME (keep original), SNAKE_CASE (convert camelCase to snake_case)
# Default: SNAKE_CASE
export.namingStrategy=SNAKE_CASE

# Convert camelCase column names to snake_case.
# Default: true
export.convertCamelCase=true

# Include Parquet schema metadata in output files.
# Default: true
export.includeSchemaInfo=true

# -----------------------------------------------------------------------------
# AWS KMS Encryption (OPTIONAL)
# -----------------------------------------------------------------------------
# Uncomment and configure to enable KMS envelope encryption for Parquet files.

# AWS KMS key ID, ARN, or alias (required for encryption)
# aws.kms.keyId=arn:aws:kms:us-east-1:123456789012:key/12345678-1234-1234-1234-123456789012

# AWS region for KMS operations
# aws.kms.region=us-east-1

# AWS profile from ~/.aws/credentials (optional, uses default chain if not set)
# aws.profile=default

# Custom KMS endpoint URL for VPC PrivateLink access (optional)
# aws.kms.endpointUrl=https://vpce-xxxx.kms.us-east-1.vpce.amazonaws.com
